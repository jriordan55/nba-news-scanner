# The Odds API key (https://the-odds-api.com). Classic v4 key.
ODDS_API_KEY=

# Discord: channel settings -> Integrations -> Webhooks -> copy the webhook URL.
DISCORD_WEBHOOK_URL=

# Telegram: message @BotFather, create a bot, then message the bot and
# open https://api.telegram.org/bot<TOKEN>/getUpdates to read your chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# How often to re-read Full Court Press, in seconds.
POLL_SECONDS=1

# On startup, act on public items newer than this. Older ones are marked seen.
LOOKBACK_HOURS=12

# Only attach a line if that player's team tips inside this window.
MAX_TIP_HOURS=96

# Full Court Press account. The scanner uses a saved sign-in cookie, not this address by itself.
FCP_EMAIL=
